# 복사해서 .env 로 쓰세요: cp .env.example .env
# .env 는 .gitignore 에 있어 커밋되지 않습니다. 실제 키는 .env 에만 넣으세요.

# 어떤 이미지 AI 를 쓸지: gemini | openai | mix(후보마다 번갈아)
LOGO_PROVIDER=gemini

# Google AI Studio 키 (https://aistudio.google.com/apikey)
GEMINI_API_KEY=여기에_gemini_키

# OpenAI 키 (https://platform.openai.com/api-keys)
OPENAI_API_KEY=여기에_openai_키

# 브랜드북 생성용 Anthropic 키 (https://console.anthropic.com/settings/keys)
# 없으면 브랜드북은 템플릿 문구로 채워집니다.
ANTHROPIC_API_KEY=여기에_anthropic_키

# Supabase 인증·저장 — 로그인한 사용자만 생성 API 를 쓸 수 있다
# (anon key 는 공개용 키라 프론트 번들에 들어가도 된다. service_role 키는 넣지 말 것)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=anon_key

# (선택) 계정별 무료 이용 횟수 — 배포(Vercel)에서만 적용, supabase/usage_quota.sql 필요
# FREE_LOGO_GENERATIONS=1            # 로고 생성 (1회 = 후보 2장)
# FREE_LOGO_EDITS=1                  # AI 수정
# FREE_BRANDBOOKS=1                  # 브랜드북 생성
# QUOTA_EXEMPT_EMAILS=me@example.com,team@example.com   # 제한을 받지 않는 계정

# (선택) 모델·품질 오버라이드
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_TEXT_MODEL=gpt-4o-mini
# OPENAI_IMAGE_QUALITY=medium        # low | medium | high  (요금 차이 큼)
# BRANDBOOK_MODEL=claude-opus-5
